{
  "name": "word-games",
  "version": "0.1.0",
  "private": true,
  "description": "A static site of original, single-player daily word games.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fallow": "fallow",
    "check": "npm run typecheck && npm run lint && npm run test && npm run fallow && npm run build && npm run test:e2e",
    "build:dictionary": "node scripts/build-dictionary.ts",
    "generate": "node scripts/generate-puzzles.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "fallow": "^3.32.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
